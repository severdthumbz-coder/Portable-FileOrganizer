<Application x:Class="FileOrganizer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FileOrganizer"
             xmlns:converters="clr-namespace:FileOrganizer.Converters"
             Startup="Application_Startup">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    OnboardingKit resources (Build 1.5.0) — MUST be merged BEFORE the theme so the
                    theme's Onb* brush aliases (defined inside each theme dictionary) win over the
                    kit's dark defaults. App.ApplyTheme() preserves this dictionary when switching
                    themes (it replaces only the theme entry), so the tour/legend never lose their
                    styles on a theme toggle.
                -->
                <ResourceDictionary Source="Onboarding/Onboarding.xaml"/>
                <!-- Light Theme (Default) -->
                <ResourceDictionary Source="Themes/LightTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--
                Converters live at application scope so that tab UserControls
                (Views/*.xaml) can resolve them via StaticResource. Previously these
                were declared in Window.Resources, which is not visible to separately
                loaded UserControls.
            -->
            <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <converters:BoolToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:ProgressBarWidthConverter x:Key="ProgressBarWidthConverter"/>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <converters:ExpandCollapseConverter x:Key="ExpandCollapseConverter"/>
            <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
            <local:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
